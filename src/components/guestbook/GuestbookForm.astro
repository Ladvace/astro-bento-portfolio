---
import { Icon } from "astro-icon/components";
import Button from "../Button.astro";
import Card from "../Card/index.astro";
import { GUESTBOOK_INPUT_CLASS as inputClasses } from "../../lib/guestbook";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Card height="h-auto" class={className}>
  <details class="group guestbook-disclosure">
    <summary
      class="flex items-center justify-between text-white cursor-pointer list-none"
    >
      <span class="text-xl font-bold">Leave a message</span>
      <Icon
        name="pixel-plus"
        class="w-4 h-4 text-darkslate-300 group-hover:text-white transition-[color,transform] duration-200 group-open:rotate-45"
      />
    </summary>

    <form id="guestbook-form" class="pt-5 flex flex-col gap-3">
      <div class="flex gap-3">
        <label class="flex-1">
          <span class="block text-xs text-darkslate-300 mb-1.5">Name *</span>
          <input
            type="text"
            name="name"
            required
            maxlength="100"
            class={inputClasses}
            placeholder="Your name"
          />
        </label>
        <label class="flex-1">
          <span class="block text-xs text-darkslate-300 mb-1.5">Website</span>
          <input
            type="url"
            name="website"
            maxlength="200"
            class={inputClasses}
            placeholder="https://..."
          />
        </label>
      </div>

      <label>
        <span class="block text-xs text-darkslate-300 mb-1.5">Message *</span>
        <textarea
          name="message"
          required
          maxlength="1000"
          rows="3"
          class:list={[inputClasses, "resize-none"]}
          placeholder="Say something..."></textarea>
      </label>

      <p data-form-error class="text-red-400 text-xs hidden"></p>

      <div class="self-end">
        <Button type="submit" size="sm">Send</Button>
      </div>
    </form>
  </details>
</Card>

<script>
  import { rotationFromSeed } from "../../lib/guestbook";
  import {
    createEntryElement,
    createFormStatus,
    postGuestbookEntry,
    readGuestbookSubmission,
    type CreatedGuestbookEntry,
  } from "../../lib/guestbook-client";

  const prependEntryToGrid = (entry: CreatedGuestbookEntry): void => {
    const entriesGrid = document.getElementById("entries");
    const card = createEntryElement("entry-card-template", entry);
    const thread = card?.querySelector<HTMLElement>("[data-reply-thread]");
    if (!entriesGrid || !card || !thread) return;

    card.style.setProperty("--tilt", `${rotationFromSeed(entry.id)}deg`);
    thread.dataset.parentId = String(entry.id);

    entriesGrid.querySelector("[data-empty-state]")?.remove();
    entriesGrid.prepend(card);
    document.dispatchEvent(new Event("guestbook:entry-added"));
  };

  const incrementEntriesCount = (): void => {
    const entriesCountHeading = document.getElementById("entries-count");
    if (!entriesCountHeading) return;
    const nextCount = parseInt(entriesCountHeading.textContent ?? "0", 10) + 1;
    entriesCountHeading.textContent = `${nextCount} messages`;
  };

  function attachFormHandler(): void {
    const form = document.getElementById(
      "guestbook-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.handlerAttached === "1") return;
    form.dataset.handlerAttached = "1";

    const { showError, setSubmitting } = createFormStatus(form);

    form.addEventListener("submit", async (submitEvent) => {
      submitEvent.preventDefault();
      showError(null);

      const submission = readGuestbookSubmission(form);
      if (!submission.name || !submission.message) {
        showError("Name and message are required");
        return;
      }

      setSubmitting(true);
      const result = await postGuestbookEntry(submission);
      setSubmitting(false);

      if ("error" in result) {
        showError(result.error);
        return;
      }

      prependEntryToGrid(result.entry);
      incrementEntriesCount();

      form.reset();
      form.closest("details")?.removeAttribute("open");
    });
  }

  document.addEventListener("astro:page-load", attachFormHandler);
</script>
