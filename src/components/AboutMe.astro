---
import Card from "./Card/index.astro";

const stack = [
  { group: "Languages", items: ["TypeScript", "CSS / SCSS"] },
  {
    group: "Frontend",
    items: [
      "React",
      "Next.js",
      "Astro",
      "Solid.js",
      "Svelte",
      "Qwik",
      "React Native",
      "Electron",
    ],
  },
  {
    group: "Styling & motion",
    items: ["Tailwind", "UnoCSS", "GSAP", "Motion", "Rive", "Three.js"],
  },
  {
    group: "Backend & APIs",
    items: ["Node.js", "NestJS", "Express", "tRPC", "better-auth"],
  },
  {
    group: "Databases",
    items: ["PostgreSQL", "MongoDB", "Prisma"],
  },
  {
    group: "Design & content",
    items: [
      "Figma",
      "Adobe Illustrator",
      "Blender",
      "Strapi",
      "UX / UI",
      "SEO",
    ],
  },
];

const CHIP =
  "text-2xs px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150 cursor-default";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-6"
  title="Stack & tools"
  class="pad-lg"
>
  <div class="flex flex-col gap-3">
    {
      stack.map(({ group, items }) => (
        <div class="flex flex-col gap-1.5">
          <span class="text-3xs uppercase tracking-wider text-darkslate-400">
            {group}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {items.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Card>
