---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";

const socialLinkClass =
  "inline-block w-fit text-darkslate-100 hover:text-primary-400 hover:translate-x-0.5 transition-all duration-150";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4" class="pad-lg">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold">
        Let's start working together!
      </h2>
    </header>
    <address class="flex flex-col mt-4">
      <h2 class="text-darkslate-300">Contact Details</h2>
      <p class="text-sm break-words">{SITE.links.email}</p>
      <p>{SITE.location.countryName}</p>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h2 class="text-darkslate-300">Find me on</h2>
      <ul>
        <li>
          <a href={SITE.links.linkedin} target="_blank" class={socialLinkClass}
            >Linkedin</a
          >
        </li>
        <li>
          <a href={SITE.links.github} target="_blank" class={socialLinkClass}
            >Github</a
          >
        </li>
        <li>
          <a href={SITE.links.medium} target="_blank" class={socialLinkClass}
            >Medium</a
          >
        </li>
        <li>
          <a href={SITE.links.dribbble} target="_blank" class={socialLinkClass}
            >Dribbble</a
          >
        </li>
        <li>
          <a href={SITE.links.behance} target="_blank" class={socialLinkClass}
            >Behance</a
          >
        </li>
      </ul>
    </div>
  </div>
</Card>
