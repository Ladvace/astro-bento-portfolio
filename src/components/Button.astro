---
interface Props {
  rounded?: boolean;
  size?: "sm";
  type?: "button" | "submit";
  class?: string;
}

const { rounded, size, ...props } = Astro.props;
---

<span class="btn-shell inline-flex w-fit h-full">
  <button
    {...props}
    class={`btn--ns btn-chrome h-full w-fit max-h-[50px] px-5 py-2 cursor-pointer disabled:opacity-50 ${
      size === "sm" ? "text-sm" : "text-xl"
    } ${rounded ? "rounded-full" : "rounded-lg"} ${props.class ?? ""}`}
  >
    <slot />
  </button>
</span>
