---
interface Props {
  rounded?: boolean;
  class?: string;
}

const { rounded, ...props } = Astro.props;
---

<span class="btn-shell inline-flex w-fit h-full">
  <button
    {...props}
    class={`btn--ns btn-chrome h-full w-fit text-xl max-h-[50px] px-5 py-2 cursor-pointer ${
      rounded ? "rounded-full" : "rounded-lg"
    } ${props.class ?? ""}`}
  >
    <slot />
  </button>
</span>
