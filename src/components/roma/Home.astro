---
import RomaLayout from '../../layouts/RomaLayout.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Steps from './Steps.astro';
import Team from './Team.astro';
import Cases from './Cases.astro';
import Testimonials from './Testimonials.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import { areaContact, contactEmailHref } from '../../lib/landing.mjs';
import { getWebsiteContent } from '../../lib/website-content';
interface Props { locale: 'es' | 'en'; projects: {slug:string;title:string;description?:string;image?:string|null;date_created?:string}[] }
const {locale, projects} = Astro.props;
const site = await getWebsiteContent(locale);
const home = site.home;
const {globals} = site;
const whatsapp = [
 {area: 'legal', label: home.legal_contact_label, ...areaContact(site, 'legal')},
 {area: 'data', label: home.data_contact_label, ...areaContact(site, 'data')},
].filter(item => item.whatsapp);
const email = contactEmailHref(site);
---
<RomaLayout locale={locale} content={site} title={home.seo_title} description={home.seo_description}>
 <Hero site={site} />
 <Services site={site} locale={locale} />
 <Steps site={site} />
 <Team site={site} />
 <Cases site={site} locale={locale} projects={projects} />
 <Testimonials site={site} />
 <Faq site={site} />
 <section id="contacto" class="roma-section roma-container contact-section" aria-labelledby="contact-title">
  <div class="contact-intro">
   <p class="eyebrow">{home.contact_label}</p>
   <h2 id="contact-title">{home.contact_title}</h2>
   <p>{home.contact_description}</p>
   {whatsapp.length > 0 && <div class="contact-actions">{whatsapp.map((item, index) => <a class={`roma-btn ${index === 0 ? 'roma-btn--primario' : 'roma-btn--secundario'}`} href={item.href} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-area={item.area} data-location="contact">{item.label}</a>)}</div>}
   {email && <p class="contact-email"><span>{home.form_email_label}</span> <a class="text-link" href={email} data-track="email_click" data-location="contact">{globals.contact_email}</a></p>}
  </div>
  <div class="contact-form-card">
   <h3>{home.form_title}</h3>
   <ContactForm site={site} locale={locale} location="contact" />
  </div>
 </section>
</RomaLayout>
