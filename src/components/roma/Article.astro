---
import RomaLayout from '../../layouts/RomaLayout.astro';
import { getWebsiteContent } from '../../lib/website-content';
import { safeExternalUrl, sanitizeArticleHtml } from '../../lib/rich-text.mjs';

interface Props {
  locale: 'es' | 'en';
  project: {
    slug: string;
    title: string;
    description?: string;
    content?: string | null;
    image?: string | null;
    date_created?: string;
    repo_link?: string | null;
    url?: string | null;
  };
}
const { locale, project } = Astro.props;
const site = await getWebsiteContent(locale);
const {globals, common, people} = site;
const es = locale === 'es';
const canonicalPath = `/${locale}/blog/${project.slug}/`;
const crumbs = [{ name: globals.brand_name, path: `/${locale}/` }, { name: common.blog_title, path: `/${locale}/blog/` }, { name: project.title, path: canonicalPath }];
const image = project.image ? `https://cms.romahomestore.com/assets/${project.image}?width=1200&height=630&fit=cover&format=webp&quality=80` : undefined;
const body = sanitizeArticleHtml(project.content);
const repo = safeExternalUrl(project.repo_link);
const demo = safeExternalUrl(project.url);
const date = project.date_created ? new Date(project.date_created) : null;
const validDate = date && !Number.isNaN(date.valueOf()) ? date : null;
---
<RomaLayout locale={locale} content={site} title={`${project.title} — ${globals.seo_suffix}`} description={project.description || common.article_description_default} canonicalPath={canonicalPath} article={true} crumbs={crumbs} pubDate={validDate?.toISOString()} image={image}>
  <section class="roma-container roma-section">
    <article>
      <header class="article-head">
        <a class="text-link" href={`/${locale}/blog/`}>← {common.article_back_label}</a>
        <p class="eyebrow">{common.article_eyebrow}</p>
        <h1 class="roma-t-h1">{project.title}</h1>
        <p>{project.description}</p>
        <p>{common.article_by_label} {people.henry.name}{validDate && <> · <time datetime={validDate.toISOString()}>{new Intl.DateTimeFormat(es ? 'es-CO' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(validDate)}</time></>}</p>
        {common.article_original_note && <p class="article-note">{common.article_original_note}</p>}
      </header>
      {image && <img class="article-cover" src={image} alt={project.title} width="1200" height="630" fetchpriority="high" />}
      {body ? <div class="prose-content" lang="en" set:html={body} /> : <p class="article-note">{common.article_empty_note}</p>}
      {(repo || demo) && <nav class="article-links" aria-label={common.article_resources_label}>
        {repo && <a class="text-link" href={repo} target="_blank" rel="noopener noreferrer">{common.article_resource_label} ↗</a>}
        {demo && demo !== repo && <a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">{common.article_demo_label} ↗</a>}
      </nav>}
      <footer class="article-links">
        <a class="text-link" href={`/${locale}/project/`}>{common.article_projects_label} →</a>
        <a class="text-link" href={`/${locale}/#contacto`}>{common.article_contact_label} →</a>
      </footer>
    </article>
  </section>
</RomaLayout>
