---
interface Props {
  href?: string;
  class?: string;
  label?: string;
}

const {
  href = "/playground",
  class: extraClass = "",
  label = "Back",
} = Astro.props;
---

<span class:list={["btn-shell btn-shell--flat inline-flex w-fit", extraClass]}>
  <a
    href={href}
    class="btn--ns inline-flex items-center w-fit px-4 py-2 rounded-lg border border-primary-500 bg-darkslate-900 text-darkslate-50 shadow-custom shadow-primary-500 hover:text-primary-500 active:shadow-none active:translate-x-[3px] active:translate-y-[3px] transition-colors duration-100 ease-in-out"
  >
    {label}
  </a>
</span>
