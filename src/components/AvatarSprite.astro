---
import { DEFAULT_SHEET, SPRITE } from "../lib/avatar-sprite.mjs";

/**
 * One animated cell of a turntable spritesheet. The stepping CSS lives here
 * only; consumers drive playback with `:global(.avatar-sprite…)` rules.
 */
interface Props {
  id?: string;
  class?: string;
  sheet?: string;
  /** Width follows from the cell aspect ratio. */
  height: string;
  duration?: string;
  label: string;
}

const {
  id,
  class: className,
  sheet = DEFAULT_SHEET,
  height,
  duration = "2.4s",
  label,
  ...rest
} = Astro.props;

if (SPRITE.COLS !== 6 || SPRITE.ROWS !== 4) {
  throw new Error(
    `AvatarSprite CSS is written for 6x4, SPRITE is ${SPRITE.COLS}x${SPRITE.ROWS}`,
  );
}
---

<div
  id={id}
  role="img"
  aria-label={label}
  class:list={["avatar-sprite", className]}
  style={`--sprite-height:${height};--sprite-duration:${duration};background-image:url("${sheet}")`}
  {...rest}
>
</div>

<style>
  /*
   * Two stepped animations on two separate longhands: one animation cannot hold
   * two stepped axes, and the shorthand would have one overwrite the other.
   * 600% 400% overflows the box by 5x width and 3x height, and percentage
   * positions measure against that overflow -- hence 0..120% and 0..133.3%.
   */
  .avatar-sprite {
    height: var(--sprite-height);
    /* Pins the width, so no layout shift without an <img>'s intrinsic size. */
    aspect-ratio: 414 / 390; /* SPRITE.CELL_W / CELL_H */
    background-size: 600% 400%;
    background-repeat: no-repeat;
    background-position: 0% 0%;
    animation:
      avatar-sprite-col calc(var(--sprite-duration) / 4) steps(6) infinite,
      avatar-sprite-row var(--sprite-duration) steps(4) infinite;
  }

  @keyframes avatar-sprite-col {
    from {
      background-position-x: 0%;
    }
    to {
      background-position-x: 120%;
    }
  }

  @keyframes avatar-sprite-row {
    from {
      background-position-y: 0%;
    }
    to {
      background-position-y: 133.3333%;
    }
  }

  .avatar-sprite.is-manual {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-sprite {
      animation: none;
      background-position: 0% 0%;
    }
  }
</style>
