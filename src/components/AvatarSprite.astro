---
import { DEFAULT_SHEET, SPRITE } from "../lib/avatar-sprite.mjs";

interface Props {
  id?: string;
  class?: string;
  sheet?: string;
  themed?: boolean;
  levitate?: boolean;
  spinOnReveal?: boolean;
  height: string;
  duration?: string;
  label: string;
}

const {
  id,
  class: className,
  sheet = DEFAULT_SHEET,
  themed = false,
  levitate = false,
  spinOnReveal = false,
  height,
  duration = "2.4s",
  label,
  ...rest
} = Astro.props;

const backgroundImage = themed
  ? `var(--memoji-sheet, url("${sheet}"))`
  : `url("${sheet}")`;

if (SPRITE.COLS !== 6 || SPRITE.ROWS !== 4) {
  throw new Error(
    `AvatarSprite CSS is written for 6x4, SPRITE is ${SPRITE.COLS}x${SPRITE.ROWS}`,
  );
}
---

<div
  id={id}
  role="img"
  aria-label={label}
  class:list={[
    "avatar-sprite",
    levitate && "avatar-levitating",
    spinOnReveal && "spin-paused",
    className,
  ]}
  style={`--sprite-height:${height};--sprite-duration:${duration};background-image:${backgroundImage}`}
  {...rest}
>
</div>

<style>
  .avatar-sprite {
    height: var(--sprite-height);
    aspect-ratio: 414 / 390; /* SPRITE.CELL_W / CELL_H */
    background-size: 600% 400%;
    background-repeat: no-repeat;
    background-position: 0% 0%;
    --sprite-frames:
      avatar-sprite-col calc(var(--sprite-duration) / 4) steps(6) infinite,
      avatar-sprite-row var(--sprite-duration) steps(4) infinite;
    --sprite-levitate: none;
    animation: var(--sprite-frames), var(--sprite-levitate);
  }

  .avatar-sprite.avatar-levitating {
    --sprite-levitate: avatar-levitate 3s ease-in-out infinite;
  }

  .avatar-sprite.is-manual {
    --sprite-frames: none, none;
  }

  /* Levitation is the third slot and keeps running. */
  .avatar-sprite.spin-paused {
    animation-play-state: paused, paused, running;
  }

  :global(html.grid-revealed) .avatar-sprite.spin-paused {
    animation-play-state: running;
  }

  @keyframes avatar-levitate {
    0%,
    100% {
      translate: 0 -10px;
    }
    50% {
      translate: 0 10px;
    }
  }

  @keyframes avatar-sprite-col {
    from {
      background-position-x: 0%;
    }
    to {
      background-position-x: 120%;
    }
  }

  @keyframes avatar-sprite-row {
    from {
      background-position-y: 0%;
    }
    to {
      background-position-y: 133.3333%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-sprite {
      --sprite-frames: none, none;
      --sprite-levitate: none;
      background-position: 0% 0%;
    }
  }
</style>
