---
import Card from "./Card/index.astro";
import { cssVars, frameVars } from "../lib/nine-slice";
import { AVATAR_THEMES } from "../lib/avatar-sprite.mjs";

const swatchVars = cssVars(frameVars("sw", { cornerSize: 12 }));

/* Kept here, not in the theme table: UnoCSS only scans files it compiles. */
const SWATCH: Record<string, string> = {
  red: "bg-[#e63946]",
  yellow: "bg-yellow-500",
  blue: "bg-blue-500",
  purple: "bg-purple-500",
  green: "bg-green-500",
};
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" padding="p-4">
  <div class="flex flex-col items-center justify-center h-full gap-2">
    <div class="theme-colors flex items-center gap-3" style={swatchVars}>
      {
        AVATAR_THEMES.map(({ theme, name }) => (
          <button
            class={`theme-btn w-6 h-6 rounded-full transition-all duration-200 ${SWATCH[name]}`}
            data-theme={theme}
            aria-label={`${name} theme`}
          />
        ))
      }
    </div>
  </div>
</Card>

<style>
  .theme-btn {
    outline: none;
    box-shadow: 0 0 0 2px transparent;
    transform: rotate(var(--sw-rotate, 0deg)) scale(1);
  }
  .theme-btn:hover {
    transform: rotate(var(--sw-rotate, 0deg)) scale(1.2);
  }
  .theme-btn.active {
    box-shadow:
      0 0 0 2px rgba(255, 255, 255, 0.15),
      0 0 0 3.5px white;
    transform: rotate(var(--sw-rotate, 0deg)) scale(1.15);
  }
</style>

<script>
  import { CHIME, play } from "../lib/sound";
  import { applyAppearance } from "../lib/appearance";

  document.addEventListener("astro:page-load", () => {
    const themeButtons = document.querySelectorAll<HTMLElement>(".theme-btn");

    const updateSelectedTheme = () => {
      const current = localStorage.getItem("theme") || "default";
      themeButtons.forEach((btn) =>
        btn.classList.toggle("active", btn.dataset.theme === current),
      );
    };

    updateSelectedTheme();

    themeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.dataset.theme as string;
        localStorage.setItem("theme", theme);
        applyAppearance();
        updateSelectedTheme();
        play(CHIME);
        document.dispatchEvent(
          new CustomEvent("themechange", { detail: { theme } }),
        );
      });
    });
  });
</script>
