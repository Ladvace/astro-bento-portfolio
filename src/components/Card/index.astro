---
import { Icon } from "astro-icon/components";
import Content from "./Content.astro";
import { CARD_FRAME, cssVars } from "../../lib/nine-slice";

interface Props {
  title?: string;
  colSpan?: string;
  rowSpan?: string;
  href?: string;
  height?: string;
  padding?: string;
  arrowCorner?: boolean;
  centerY?: boolean;
  prefetch?: "hover" | "viewport" | "load" | "tap";
  nsPadY?: string;
  class?: string;
}

const {
  title,
  colSpan,
  rowSpan,
  href,
  height,
  padding,
  arrowCorner,
  centerY,
  prefetch,
  nsPadY,
  class: className,
} = Astro.props;

const chrome = `bg-darkslate-500 shadow-lg rounded-lg border border-darkslate-400 hover:border-primary-500 card--ns`;

const nsVars = cssVars({
  ...CARD_FRAME,
  "--ns-pad-y": nsPadY,
});
---

<div
  class={`card group overflow-hidden min-w-0 transfor-y-[-40%] ${chrome} align-start flex-none ${
    height || "h-full"
  } ${
    href || centerY ? "flex flex-col justify-center" : "justify-start"
  } relative transform perspective-1200 w-full transition-[border-color,box-shadow,background-color,transform] duration-150 ease-out col-span-1 ${
    colSpan || "md:col-span-2"
  } ${rowSpan || ""} ${padding || "p-6"} ${className || ""}`}
  style={nsVars}
>
  <slot name="background" />
  {
    href ? (
      <a
        class="h-auto w-full flex flex-col relative"
        href={href}
        data-astro-prefetch={prefetch}
      >
        <Icon
          class={`h-5 w-5 absolute right-0 group-hover:text-primary-500 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform ease-in-out duration-100 z-20 flex-shrink-0 ${arrowCorner ? "top-0" : "inset-y-0 my-auto"}`}
          name="ri:arrow-right-up-line"
        />
        <Content title={title}>
          <slot />
        </Content>
      </a>
    ) : (
      <Content title={title}>
        <slot />
      </Content>
    )
  }
</div>
