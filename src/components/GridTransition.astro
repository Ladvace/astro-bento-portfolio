<div id="grid-transition" aria-hidden="true" transition:persist></div>

<style is:global>
  #grid-transition > div {
    background: var(--grid-cell);
  }

  #grid-transition {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: grid;
    overflow: hidden;
    background: #111111;
  }
</style>

<script>
  const THEME_CLASSES = [
    "yellow-theme",
    "blue-theme",
    "purple-theme",
    "green-theme",
  ];
  const STYLE_CLASSES = [
    "style-glass",
    "style-sharp",
    "style-neon",
    "style-paper",
  ];

  const TARGET_CELL_SIZE = 40;
  const COVER_DURATION = 0.2;
  const COVER_SPREAD = 0.35;
  const REVEAL_DURATION = 0.25;
  const REVEAL_SPREAD = 0.35;
  const FIRST_LOAD_SPREAD = 0.55;
  const overlay = document.getElementById("grid-transition") as HTMLElement;
  let cells: HTMLElement[] = [];
  let gridCols = 0;
  let gridRows = 0;
  let phase = Math.random() * Math.PI * 2;
  let running: Animation[] = [];

  function buildGrid() {
    gridCols = Math.max(1, Math.round(window.innerWidth / TARGET_CELL_SIZE));
    const cellSize = window.innerWidth / gridCols;
    gridRows = Math.ceil(window.innerHeight / cellSize) + 1;
    overlay.style.gridTemplateColumns = `repeat(${gridCols}, ${cellSize}px)`;
    overlay.style.gridTemplateRows = `repeat(${gridRows}, ${cellSize}px)`;
    cancelRunning();
    const fragment = document.createDocumentFragment();
    cells = Array.from({ length: gridCols * gridRows }, () => {
      const cell = document.createElement("div");
      fragment.appendChild(cell);
      return cell;
    });
    overlay.replaceChildren(fragment);
  }

  function applyTheme() {
    const theme = localStorage.getItem("theme");
    document.body.classList.remove(...THEME_CLASSES);
    if (theme && theme !== "default") document.body.classList.add(theme);
    const portfolioStyle = localStorage.getItem("portfolioStyle");
    document.body.classList.remove(...STYLE_CLASSES);
    const customBorder =
      (localStorage.getItem("cardBorder") ?? "custom") === "custom";
    if (!customBorder && portfolioStyle && portfolioStyle !== "default")
      document.body.classList.add(portfolioStyle);
    const color = getComputedStyle(document.body)
      .getPropertyValue("--primary-500")
      .trim();
    overlay.style.setProperty("--grid-cell", color);
    overlay.style.background = "transparent";
  }

  function cosNoise(nx: number, ny: number): number {
    return (
      Math.cos(nx * 6.2 + ny * 3.7 + phase) * 0.4 +
      Math.cos(nx * 2.1 - ny * 8.5 + phase * 1.3) * 0.35 +
      Math.cos(nx * 11.3 + ny * 1.9 + phase * 0.7) * 0.25 +
      Math.cos(nx * 24.7 + ny * 19.3 + phase * 1.7) * 0.15 +
      Math.cos(nx * 37.1 - ny * 31.6 + phase * 0.5) * 0.1
    );
  }

  function cellDelay(spread: number) {
    return (i: number): number => {
      const col = i % gridCols;
      const row = Math.floor(i / gridCols);
      const nx = col / Math.max(gridCols - 1, 1);
      const ny = row / Math.max(gridRows - 1, 1);
      const base = 1 - ny;
      const noise = cosNoise(nx, ny) * 0.22;
      const edgeFactor = 4 * base * (1 - base);
      const jitter = (Math.random() - 0.5) * 0.2 * edgeFactor;
      return Math.max(0, (base * 0.55 + noise + jitter) * spread);
    };
  }

  function setCellOpacity(value: number) {
    for (const cell of cells) cell.style.opacity = String(value);
  }

  function cancelRunning() {
    for (const animation of running) animation.cancel();
    running = [];
  }

  /** Resolves false when a newer transition cancelled this one. */
  function animateCells(
    to: number,
    duration: number,
    spread: number,
  ): Promise<boolean> {
    cancelRunning();

    const delayFor = cellDelay(spread);
    const durationMs = duration * 1000;
    const batch: Animation[] = [];
    let lastDelay = -1;
    let last: Animation | undefined;

    for (let i = 0; i < cells.length; i++) {
      const delay = delayFor(i) * 1000 + durationMs;
      const animation = cells[i].animate(
        { opacity: to },
        { duration: 0, delay, fill: "forwards" },
      );
      batch.push(animation);
      if (delay > lastDelay) {
        lastDelay = delay;
        last = animation;
      }
    }
    running = batch;

    return Promise.resolve(last?.finished)
      .catch(() => {})
      .then(() => {
        if (running !== batch) return false;
        cancelRunning();
        setCellOpacity(to);
        return true;
      });
  }

  function startTransition() {
    phase = Math.random() * Math.PI * 2;
    applyTheme();
  }

  function cover(): Promise<boolean> {
    startTransition();
    document.documentElement.classList.remove("grid-revealed");
    overlay.style.pointerEvents = "all";
    return animateCells(1, COVER_DURATION, COVER_SPREAD);
  }

  function reveal(spread = FIRST_LOAD_SPREAD): Promise<void> {
    startTransition();
    document.dispatchEvent(new CustomEvent("grid:reveal-start"));
    return animateCells(0, REVEAL_DURATION, spread).then((completed) => {
      if (!completed) return;
      overlay.style.pointerEvents = "none";
      document.documentElement.classList.add("grid-revealed");
      document.dispatchEvent(new CustomEvent("grid:revealed"));
    });
  }

  buildGrid();
  applyTheme();
  setCellOpacity(1);
  requestAnimationFrame(() => reveal());

  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener("resize", () => {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      buildGrid();
      applyTheme();
      setCellOpacity(0);
    }, 150);
  });

  type NavigationLoader = () => Promise<unknown>;
  type AstroBeforePreparationEvent = Event & {
    sourceElement?: HTMLElement | null;
    loader: NavigationLoader;
  };

  let skipNextTransition = false;

  document.addEventListener("astro:before-preparation", (preparationEvent) => {
    const navigationEvent = preparationEvent as AstroBeforePreparationEvent;
    const triggeringElement =
      navigationEvent.sourceElement?.closest<HTMLElement>("[data-skip-loader]");
    if (triggeringElement) {
      skipNextTransition = true;
      return;
    }
    const originalLoader = navigationEvent.loader;
    navigationEvent.loader = () => Promise.all([cover(), originalLoader()]);
  });

  document.addEventListener("astro:after-swap", () => {
    if (skipNextTransition) {
      skipNextTransition = false;
      applyTheme();
      document.documentElement.classList.add("grid-revealed");
      document.dispatchEvent(new CustomEvent("grid:revealed"));
      return;
    }
    reveal(REVEAL_SPREAD);
  });
</script>
