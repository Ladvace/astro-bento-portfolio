---
import BasicLayout from "./BasicLayout.astro";

interface Props {
  title: string;
  description: string;
  hideSoundToggle?: boolean;
  noindex?: boolean;
}

const { title, description, hideSoundToggle, noindex } = Astro.props;
---

<BasicLayout
  description={description}
  title={title}
  hideSoundToggle={hideSoundToggle}
  noindex={noindex}
>
  <slot />
</BasicLayout>
