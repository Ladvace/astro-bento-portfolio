---
import { legacyRedirect } from '../../../lib/seo.mjs';
export const prerender = false;
if (!['es', 'en'].includes(Astro.params.locale ?? '')) return new Response(null, { status: 404 });
const target = legacyRedirect(Astro.url.pathname);
return target ? Astro.redirect(target, 301) : new Response(null, { status: 404 });
---
