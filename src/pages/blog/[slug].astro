---
import { hasArticle } from '../../lib/legacy-slugs.mjs';
import { legacyRedirect } from '../../lib/seo.mjs';
export const prerender = false;

const target = legacyRedirect(Astro.url.pathname, { hasArticle });
return target ? Astro.redirect(target, 301) : new Response(null, { status: 404 });
---
