---
import PlaygroundShell from "../../components/PlaygroundShell.astro";
import { SITE } from "../../site-config";

// 24 frames rendered in Blender (Cycles, orthographic camera, transparent film),
// spun about the model's own vertical axis so the sprite never drifts off centre.
const COLS = 6;
const ROWS = 4;
const FRAMES = COLS * ROWS;

export const prerender = true;
---

<PlaygroundShell
  title={`${SITE.author.fullName} - Playground - Avatar turntable`}
  description="A 24-frame Blender render of my avatar, animated as a CSS spritesheet"
>
  <div class="tt-stage" id="tt-stage">
    <div class="tt-viewport">
      <div class="tt-spin" id="tt-spin"></div>
    </div>

    <p class="tt-readout">
      <span id="tt-readout">24 frames &middot; 15&deg; per step</span>
    </p>

    <figure class="tt-sheet" id="tt-sheet" hidden>
      <figcaption class="tt-label">Spritesheet &mdash; {COLS} &times; {ROWS}</figcaption>
      <img
        src="/avatar-spin.webp"
        alt={`Spritesheet of the avatar rotating 360 degrees across ${FRAMES} frames`}
        width="2484"
        height="1560"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</PlaygroundShell>

<style>
  .tt-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;

    /* Driven by Tweakpane. */
    --size: 320px;
    --duration: 2.4s;
  }

  .tt-viewport {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border: 1px solid var(--darkslate-700);
    border-radius: 14px;
    /* Checkerboard reads through the sprite's alpha. */
    background-image:
      linear-gradient(
        45deg,
        var(--darkslate-800) 25%,
        transparent 25%,
        transparent 75%,
        var(--darkslate-800) 75%
      ),
      linear-gradient(
        45deg,
        var(--darkslate-800) 25%,
        var(--darkslate-900) 25%,
        var(--darkslate-900) 75%,
        var(--darkslate-800) 75%
      );
    background-size: 24px 24px;
    background-position:
      0 0,
      12px 12px;
  }

  /*
   * A 6x4 grid stepped by two synced animations: the column animation runs one
   * full cycle per row, the row animation advances one row per cycle. Positions
   * are percentages, so the sprite scales without touching the keyframes.
   *
   * Column c sits at c / (6 - 1) * 100% = c * 20%   -> 6 stops over 0..120%
   * Row    r sits at r / (4 - 1) * 100% = r * 33.3% -> 4 stops over 0..133.3%
   */
  .tt-spin {
    width: var(--size);
    /* Cell aspect ratio, so the avatar is never stretched. */
    aspect-ratio: 414 / 390;
    background-image: url("/avatar-spin.webp");
    background-size: 600% 400%;
    background-repeat: no-repeat;
    background-position: 0% 0%;
    animation:
      tt-col calc(var(--duration) / 4) steps(6) infinite,
      tt-row var(--duration) steps(4) infinite;
  }

  @keyframes tt-col {
    from {
      background-position-x: 0%;
    }
    to {
      background-position-x: 120%;
    }
  }

  @keyframes tt-row {
    from {
      background-position-y: 0%;
    }
    to {
      background-position-y: 133.3333%;
    }
  }

  .tt-spin.is-paused {
    animation-play-state: paused;
  }

  .tt-spin.is-reversed {
    animation-direction: reverse;
  }

  /* Scrubbing takes over background-position entirely. */
  .tt-spin.is-scrubbing {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tt-spin {
      animation: none;
      background-position: 0% 0%;
    }
  }

  .tt-readout {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--darkslate-300);
  }

  .tt-sheet {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: min(100%, 620px);
  }

  .tt-sheet[hidden] {
    display: none;
  }

  .tt-sheet img {
    width: 100%;
    height: auto;
    border: 1px solid var(--darkslate-700);
    border-radius: 10px;
  }

  .tt-label {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--darkslate-300);
  }
</style>

<script>
  import { Pane } from "tweakpane";

  const COLS = 6;
  const ROWS = 4;
  const FRAMES = COLS * ROWS;

  const PARAMS = {
    size: 320,
    duration: 2400,
    playing: true,
    reversed: false,
    frame: 0,
    showSheet: false,
  };

  let pane: Pane | null = null;

  function initTurntable() {
    const stage = document.getElementById("tt-stage");
    const spin = document.getElementById("tt-spin");
    const readout = document.getElementById("tt-readout");
    const sheet = document.getElementById("tt-sheet");
    if (!stage || !spin || !readout || !sheet) return;

    const applySize = () => {
      stage.style.setProperty("--size", `${PARAMS.size}px`);
    };

    const applyDuration = () => {
      stage.style.setProperty("--duration", `${PARAMS.duration}ms`);
    };

    // Paused means "hold a chosen frame", so we drop the animation and place
    // the cell by hand; playing hands background-position back to the keyframes.
    const applyPlayback = () => {
      spin.classList.toggle("is-scrubbing", !PARAMS.playing);
      spin.classList.toggle("is-paused", !PARAMS.playing);
      if (PARAMS.playing) {
        spin.style.backgroundPosition = "";
        readout.textContent = `${FRAMES} frames · ${(360 / FRAMES).toFixed(0)}° per step`;
      } else {
        applyFrame();
      }
    };

    const applyFrame = () => {
      if (PARAMS.playing) return;
      const col = PARAMS.frame % COLS;
      const row = Math.floor(PARAMS.frame / COLS);
      spin.style.backgroundPosition = `${(col * 100) / (COLS - 1)}% ${
        (row * 100) / (ROWS - 1)
      }%`;
      const deg = Math.round((PARAMS.frame * 360) / FRAMES);
      readout.textContent = `frame ${String(PARAMS.frame).padStart(2, "0")} · ${deg}°`;
    };

    applySize();
    applyDuration();
    applyPlayback();

    pane = new Pane({ title: "Turntable" });

    pane
      .addBinding(PARAMS, "size", { min: 96, max: 520, step: 4 })
      .on("change", applySize);
    pane
      .addBinding(PARAMS, "duration", {
        label: "duration (ms)",
        min: 400,
        max: 6000,
        step: 100,
      })
      .on("change", applyDuration);
    pane.addBinding(PARAMS, "playing").on("change", () => {
      applyPlayback();
      pane?.refresh();
    });
    pane.addBinding(PARAMS, "reversed").on("change", () => {
      spin.classList.toggle("is-reversed", PARAMS.reversed);
    });
    pane
      .addBinding(PARAMS, "frame", { min: 0, max: FRAMES - 1, step: 1 })
      .on("change", () => {
        // Scrubbing implies you want to inspect a still.
        if (PARAMS.playing) {
          PARAMS.playing = false;
          applyPlayback();
          pane?.refresh();
        }
        applyFrame();
      });
    pane
      .addBinding(PARAMS, "showSheet", { label: "show sheet" })
      .on("change", () => {
        (sheet as HTMLElement).hidden = !PARAMS.showSheet;
      });
  }

  function disposeTurntable() {
    pane?.dispose();
    pane = null;
  }

  document.addEventListener("astro:page-load", initTurntable);
  document.addEventListener("astro:before-swap", disposeTurntable);
</script>
